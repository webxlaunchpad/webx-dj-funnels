// WebX DJ funnels — Cloudflare Worker. Holds no secrets: everything goes through WebX Core.
//   test: worker "webx-dj-funnels-test" → webx-core-test (Square sandbox)
//   live: worker "webx-dj-funnels"      → webx-core      (real payments)
// Affiliate (/a/) and rep (/r/) funnels are switched per environment below. Live keeps them OFF
// until Kris approves; flip "on" here and deploy.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "webx-dj-funnels-dev",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-19",
  "observability": { "enabled": true },
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "env": {
    "test": {
      "name": "webx-dj-funnels-test",
      "vars": {
        "ENVIRONMENT": "test",
        "CORE_URL": "https://webx-core-test.webxlaunchpad.workers.dev",
        "SQUARE_LOCATION_ID": "L6K03ZBG5D828",
        "AFFILIATE_FUNNEL": "on",
        "REP_FUNNEL": "on"
      },
      "services": [{ "binding": "CORE", "service": "webx-core-test" }]
    },
    "live": {
      "name": "webx-dj-funnels",
      "vars": {
        "ENVIRONMENT": "live",
        "CORE_URL": "https://webx-core.webxlaunchpad.workers.dev",
        "SQUARE_LOCATION_ID": "L7BNAT9F01DB3",
        "AFFILIATE_FUNNEL": "off",
        "REP_FUNNEL": "off",
        "META_PIXEL_ID": "3089262921275849",
        "TIKTOK_PIXEL_ID": ""
      },
      "services": [{ "binding": "CORE", "service": "webx-core" }]
    }
  }
}
